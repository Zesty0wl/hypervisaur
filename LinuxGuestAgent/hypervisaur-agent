#!/usr/bin/env python3
"""
The Hypervisaur agent for Linux, which runs programs in the virtual machine for the Mac.

It runs as a systemd service, and talks to Hypervisaur over the virtio console port named hypervisaur.agent, using the frames
that Documentation/GuestAgentProtocol.md describes. It also listens on virtio socket port 51781, which is many times faster,
and Hypervisaur uses that once it can connect to it. Each program runs on a channel of its own, in a process group of its own
so that stopping it also stops the programs it started, and with a pseudo terminal when it needs one. Files the Mac sends are
put on the desktop of the user signed in at the display.

Usage: hypervisaur-agent [port]
The port defaults to /dev/virtio-ports/hypervisaur.agent.
"""

import fcntl
import os
import platform
import pty
import pwd
import re
import signal
import socket
import stat
import struct
import subprocess
import sys
import termios
import threading
import time

PORT_PATH = "/dev/virtio-ports/hypervisaur.agent"
PROTOCOL_VERSION = 5

# The virtio socket port the agent also listens on, which is many times faster than the console port.
SOCKET_PORT = 51781

HEADER = struct.Struct("<IBI")
MAX_PAYLOAD = 1 << 20
CHUNK_SIZE = 16 * 1024

# How long output is still read after a program exits, since programs it started in the background can keep its output open.
OUTPUT_DRAIN_TIMEOUT = 2

RESET, OPEN, INPUT, INPUT_END, RESIZE, TERMINATE = 0x01, 0x02, 0x03, 0x04, 0x05, 0x06
PUT_FILES, FILE_HEADER, FILE_DATA, FILES_END, GET_FILES, ACKNOWLEDGE, CATCH_DRAG, TRANSFER_SIZE = range(0x07, 0x0F)
HELLO, OUTPUT, ERROR_OUTPUT, EXITED, FAILED, TRANSFERRED, DRAG_ITEMS = range(0x41, 0x48)

# File transfers: see Documentation/GuestAgentProtocol.md in Hypervisaur's repository.
FILE_HEADER_FORMAT = struct.Struct("<BQIq")
FILE_CHUNK_SIZE = 256 * 1024
TRANSFER_WINDOW = 4 << 20
ACKNOWLEDGEMENT_INTERVAL = 1 << 20


def log(message):
    print(message, file=sys.stderr, flush=True)


class Port:
    """The port, which frames are written to from any thread."""

    # The console port reads nothing while Hypervisaur isn't connected, rather than ending.
    ends_when_empty = False
    read_size = 64 * 1024

    def __init__(self, path):
        self.path = path
        self.fd = None
        self.lock = threading.Lock()

    def open(self):
        self.fd = os.open(self.path, os.O_RDWR)

    def send(self, kind, channel, payload=b""):
        frame = HEADER.pack(len(payload), kind, channel) + payload
        with self.lock:
            if self.fd is None:
                return
            try:
                view = memoryview(frame)
                while view:
                    written = os.write(self.fd, view)
                    view = view[written:]
            except OSError as error:
                log(f"Couldn't send a frame of kind 0x{kind:02x} on channel {channel}: {error}")

    def read(self):
        return os.read(self.fd, self.read_size)


class SocketPort(Port):
    """A connection from Hypervisaur on the virtio socket, which ends when Hypervisaur disconnects."""

    ends_when_empty = True
    read_size = 1 << 20

    def __init__(self, connection):
        super().__init__(None)
        self.connection = connection
        self.fd = connection.fileno()

    def close(self):
        with self.lock:
            self.fd = None
        self.connection.close()


class Session:
    def __init__(self, agent, channel, command, uses_terminal, columns, rows):
        self.agent = agent
        self.channel = channel
        self.terminal = None
        self.readers = []

        environment = dict(os.environ, TERM="xterm-256color")
        if command:
            arguments = ["/bin/sh", "-c", command]
        else:
            shell = pwd.getpwuid(os.getuid()).pw_shell or "/bin/sh"
            arguments = [shell, "-l"]

        if uses_terminal:
            self.terminal, child = pty.openpty()
            self.resize(columns, rows)
            self.process = subprocess.Popen(
                arguments, stdin=child, stdout=child, stderr=child, cwd="/", env=environment,
                start_new_session=True, preexec_fn=self._take_terminal, close_fds=True,
            )
            os.close(child)
            self.input = self.terminal
            self._read(self.terminal, OUTPUT)
        else:
            self.process = subprocess.Popen(
                arguments, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd="/",
                env=environment, start_new_session=True, close_fds=True,
            )
            self.input = self.process.stdin.fileno()
            self._read(self.process.stdout.fileno(), OUTPUT)
            self._read(self.process.stderr.fileno(), ERROR_OUTPUT)

        threading.Thread(target=self._wait, daemon=True).start()

    @staticmethod
    def _take_terminal():
        """Makes the pseudo terminal the program's controlling terminal, so that job control and Control-C work."""
        fcntl.ioctl(0, termios.TIOCSCTTY, 0)

    def _read(self, fd, kind):
        def read():
            while True:
                try:
                    data = os.read(fd, CHUNK_SIZE)
                except OSError:
                    break
                if not data:
                    break
                self.agent.port.send(kind, self.channel, data)

        thread = threading.Thread(target=read, daemon=True)
        thread.start()
        self.readers.append(thread)

    def _wait(self):
        status = self.process.wait()

        if self.terminal is not None:
            # The terminal's output ends once the program and everything else using the terminal have closed it.
            deadline = time.monotonic() + OUTPUT_DRAIN_TIMEOUT
            for reader in self.readers:
                reader.join(max(0, deadline - time.monotonic()))
        else:
            for reader in self.readers:
                reader.join(OUTPUT_DRAIN_TIMEOUT)

        self.agent.remove(self)
        exit_status = status if status >= 0 else 128 - status
        self.agent.port.send(EXITED, self.channel, struct.pack("<i", exit_status))
        self.close()

    def write(self, data):
        try:
            view = memoryview(data)
            while view and self.input is not None:
                written = os.write(self.input, view)
                view = view[written:]
        except OSError:
            pass

    def end_input(self):
        # A terminal's input stays open, since closing it would end the terminal.
        if self.terminal is None and self.process.stdin and not self.process.stdin.closed:
            self.process.stdin.close()
            self.input = None

    def resize(self, columns, rows):
        if self.terminal is not None and columns and rows:
            fcntl.ioctl(self.terminal, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0))

    def terminate(self):
        try:
            os.killpg(self.process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass

    def close(self):
        if self.terminal is not None:
            try:
                os.close(self.terminal)
            except OSError:
                pass
            self.terminal = None
        for stream in (self.process.stdin, self.process.stdout, self.process.stderr):
            if stream and not stream.closed:
                stream.close()


class TransferError(Exception):
    pass


def validated_components(path):
    """The path's components, after checking that it stays inside the transfer."""
    components = path.split("/")
    if not path or path.startswith("/") or any(c in ("", ".", "..") or "\0" in c for c in components):
        raise TransferError(f"A file in the transfer has a path that isn't allowed: \u201c{path}\u201d.")
    return components


def desktop_user():
    """The user signed in at the display: the user of the active graphical session on seat0."""
    try:
        listing = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None

    for line in listing.splitlines():
        fields = line.split()
        if not fields:
            continue
        try:
            output = subprocess.run(
                ["loginctl", "show-session", fields[0], "-p", "Name", "-p", "Type", "-p", "Active", "-p", "Seat", "-p", "Class"],
                capture_output=True, text=True, timeout=10,
            ).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        properties = dict(entry.split("=", 1) for entry in output.splitlines() if "=" in entry)
        if (properties.get("Seat") == "seat0" and properties.get("Active") == "yes" and properties.get("Class") == "user"
                and properties.get("Type") in ("wayland", "x11", "mir")):
            try:
                return pwd.getpwnam(properties.get("Name", ""))
            except KeyError:
                continue
    return None


# The agent runs as root, but the user it puts files on the desktop of can change anything in their home folder, including
# while a transfer is going. So nothing there is used by its path: each folder is opened from the one it's in, without
# following symbolic links, and everything is created, changed and moved through those descriptors.
FOLDER_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

# user-dirs.dirs is a few lines long; anything much larger isn't one.
USER_DIRS_MAX_SIZE = 64 * 1024


def open_folder(parent_fd, name):
    """Opens a folder in another without following a symbolic link. Fails if it's anything other than a folder."""
    return os.open(name, FOLDER_FLAGS, dir_fd=parent_fd)


def open_folders(fd, components, create_for=None):
    """Opens the folder at the path's components from the folder `fd`, each from the one before. Folders that don't exist
    are created for the user `create_for` if it's given. The caller closes the folder that's returned."""
    fd = os.dup(fd)
    try:
        for name in components:
            created = False
            if create_for is not None:
                try:
                    os.mkdir(name, 0o755, dir_fd=fd)
                    created = True
                except FileExistsError:
                    pass
            next_fd = open_folder(fd, name)
            os.close(fd)
            fd = next_fd
            if created:
                os.fchown(fd, create_for.pw_uid, create_for.pw_gid)
        return fd
    except BaseException:
        os.close(fd)
        raise


def remove_folder(parent_fd, name):
    """Removes a folder in another and everything in it. Each folder is opened from the one it's in, so nothing outside it
    is removed whatever is renamed or replaced in it meanwhile. Whatever can't be removed is left."""
    try:
        stack = [(parent_fd, name, open_folder(parent_fd, name), set())]
    except OSError:
        return
    while stack:
        _, _, fd, skipped = stack[-1]
        try:
            entries = os.listdir(fd)
        except OSError:
            entries = []
        child = None
        for entry in entries:
            if entry in skipped:
                continue
            try:
                if stat.S_ISDIR(os.stat(entry, dir_fd=fd, follow_symlinks=False).st_mode):
                    # It's only gone into once, so a folder that can't be emptied doesn't stop the rest being removed.
                    skipped.add(entry)
                    child = (fd, entry, open_folder(fd, entry), set())
                    break
                os.unlink(entry, dir_fd=fd)
            except OSError:
                skipped.add(entry)
        if child is not None:
            stack.append(child)
            continue
        parent, folder, fd, _ = stack.pop()
        os.close(fd)
        try:
            os.rmdir(folder, dir_fd=parent)
        except OSError:
            pass


def configured_desktop(home_fd, home):
    """The components of the desktop folder that the user's ~/.config/user-dirs.dirs names, relative to their home folder,
    or None if it doesn't name one inside their home folder."""
    try:
        config_fd = open_folders(home_fd, [".config"])
        try:
            # It's opened without waiting, so that a named pipe in its place can't stop the agent.
            fd = os.open("user-dirs.dirs", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=config_fd)
        finally:
            os.close(config_fd)
        with os.fdopen(fd, "rb") as file:
            if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
                return None
            text = file.read(USER_DIRS_MAX_SIZE).decode("utf-8", "replace")
    except OSError:
        return None

    components = None
    for line in text.splitlines():
        match = re.match(r'\s*XDG_DESKTOP_DIR\s*=\s*"(.*)"\s*$', line)
        if match:
            value = os.path.normpath(match.group(1).replace("$HOME", home))
            if value.startswith(home.rstrip("/") + "/"):
                components = value[len(home.rstrip("/")) + 1:].split("/")
    return components


def desktop_folder(user):
    """The user's desktop folder, as their XDG user directories name it, which is created if it doesn't exist. It must be
    inside their home folder. Returns its path and an open descriptor for it, which the caller closes."""
    home = os.path.normpath(user.pw_dir)
    home_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    try:
        components = configured_desktop(home_fd, home) or ["Desktop"]
        return os.path.join(home, *components), open_folders(home_fd, components, create_for=user)
    finally:
        os.close(home_fd)


def unique_name(folder_fd, name):
    """A name that isn't taken in the folder: the name itself, or Name (2).ext, Name (3).ext and so on."""
    def taken(candidate):
        try:
            os.stat(candidate, dir_fd=folder_fd, follow_symlinks=False)
            return True
        except FileNotFoundError:
            return False

    if not taken(name):
        return name
    base, extension = os.path.splitext(name)
    if not base:
        base, extension = name, ""
    number = 2
    while True:
        candidate = f"{base} ({number}){extension}"
        if not taken(candidate):
            return candidate
        number += 1


class IncomingTransfer:
    """Files the Mac puts on the desktop. They're written into a hidden folder there first, so that nothing is seen half
    written, then moved into place once they've all arrived. The hidden folder belongs to root, so the user can't change
    what's in it, and the items in it belong to the user. Frames are handled on the agent's thread, so writing to the disk
    holds up reading from the port, which keeps the Mac from sending faster than the files are written."""

    def __init__(self, agent, channel):
        self.agent = agent
        self.channel = channel
        self.user = desktop_user()
        if self.user is None:
            raise TransferError("Nobody is signed in at the virtual machine's display.")

        self.folders = set()
        self.files = set()
        self.top_level = []
        self.folder_times = []
        self.current = None
        self.written = 0
        self.acknowledged = 0

        self.destination, self.destination_fd = desktop_folder(self.user)
        self.staging_fd = None
        try:
            self._remove_abandoned_staging()
            self.staging_name = f".hypervisaur-{channel}-{int(time.time() * 1000)}"
            os.mkdir(self.staging_name, 0o700, dir_fd=self.destination_fd)
            staging_fd = open_folder(self.destination_fd, self.staging_name)
            # Only root can make a folder that belongs to root, so this is the one the agent made rather than one the user
            # put in its place, which is left alone.
            if os.fstat(staging_fd).st_uid != os.geteuid():
                os.close(staging_fd)
                raise TransferError("The hidden folder for the transfer was replaced while it was being made.")
            self.staging_fd = staging_fd
        except BaseException:
            self.cleanup()
            raise

    def _remove_abandoned_staging(self):
        """Removes hidden folders that copies left behind when the agent stopped during them, such as when it was updated.
        A folder that changed in the last ten minutes may belong to a copy that's still going, so it's left alone."""
        try:
            names = os.listdir(self.destination_fd)
        except OSError:
            return
        for name in names:
            if not name.startswith(".hypervisaur-"):
                continue
            try:
                info = os.stat(name, dir_fd=self.destination_fd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(info.st_mode) and time.time() - info.st_mtime > 600:
                remove_folder(self.destination_fd, name)

    def receive(self, kind, payload):
        """Handles a frame of the transfer. Returns True once the transfer has finished."""
        if kind == TRANSFER_SIZE:
            return False
        if kind == FILE_HEADER:
            self._finish_file()
            self._begin(payload)
        elif kind == FILE_DATA:
            if self.current is None or len(payload) > self.current["remaining"]:
                raise TransferError("The transfer sent more of a file than it said the file had.")
            self.current["file"].write(payload)
            self.current["remaining"] -= len(payload)
            self.written += len(payload)
        elif kind == FILES_END:
            self._finish_file()
            for components, modified in reversed(self.folder_times):
                folder_fd = open_folders(self.staging_fd, components)
                try:
                    os.utime(folder_fd, (modified, modified))
                finally:
                    os.close(folder_fd)
            self._acknowledge(force=True)
            paths = self._move_into_place()
            self.agent.port.send(TRANSFERRED, self.channel, "\n".join(paths).encode())
            return True
        self._acknowledge(force=False)
        return False

    def _acknowledge(self, force):
        due = self.written - self.acknowledged >= ACKNOWLEDGEMENT_INTERVAL or (self.current is None and self.written > self.acknowledged)
        if force or due:
            self.acknowledged = self.written
            self.agent.port.send(ACKNOWLEDGE, self.channel, struct.pack("<Q", self.written))

    def _begin(self, payload):
        if len(payload) <= FILE_HEADER_FORMAT.size:
            raise TransferError("A file's description is incomplete.")
        item_type, size, permissions, modified = FILE_HEADER_FORMAT.unpack_from(payload)
        path = payload[FILE_HEADER_FORMAT.size:].decode("utf-8", "replace")
        components = validated_components(path)

        parent = "/".join(components[:-1])
        if parent and parent not in self.folders:
            raise TransferError(f"“{path}” isn't inside a folder of the transfer.")
        if path in self.folders or path in self.files:
            raise TransferError(f"“{path}” is in the transfer twice.")
        if item_type not in (0, 1):
            raise TransferError(f"A file has a type that isn't known ({item_type}).")

        name = components[-1]
        mode = (permissions & 0o777) | 0o600 if permissions else None
        parent_fd = open_folders(self.staging_fd, components[:-1])
        try:
            if item_type == 1:
                os.mkdir(name, 0o700, dir_fd=parent_fd)
                folder_fd = open_folder(parent_fd, name)
                try:
                    os.fchown(folder_fd, self.user.pw_uid, self.user.pw_gid)
                    os.fchmod(folder_fd, mode | 0o700 if mode is not None else 0o755)
                finally:
                    os.close(folder_fd)
                self.folders.add(path)
                if modified:
                    self.folder_times.append((components, modified))
            else:
                descriptor = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent_fd)
                os.fchown(descriptor, self.user.pw_uid, self.user.pw_gid)
                self.files.add(path)
                self.current = {"file": os.fdopen(descriptor, "wb"), "remaining": size, "mode": mode, "modified": modified}
        finally:
            os.close(parent_fd)

        if len(components) == 1:
            self.top_level.append(name)
        if item_type == 0 and size == 0:
            self._finish_file()

    def _finish_file(self):
        if self.current is None:
            return
        current, self.current = self.current, None
        file = current["file"]
        try:
            if current["remaining"]:
                raise TransferError("The transfer ended before all of a file arrived.")
            file.flush()
            os.fchmod(file.fileno(), current["mode"] if current["mode"] is not None else 0o644)
            if current["modified"]:
                os.utime(file.fileno(), (current["modified"], current["modified"]))
        finally:
            file.close()

    def _move_into_place(self):
        paths = []
        for name in self.top_level:
            target = unique_name(self.destination_fd, name)
            os.rename(name, target, src_dir_fd=self.staging_fd, dst_dir_fd=self.destination_fd)
            paths.append(os.path.join(self.destination, target))
        self.cleanup()
        return paths

    def cleanup(self):
        """Removes the hidden folder and whatever is still in it. Calling it again does nothing."""
        if self.current is not None:
            self.current["file"].close()
            self.current = None
        if self.staging_fd is not None:
            os.close(self.staging_fd)
            self.staging_fd = None
            remove_folder(self.destination_fd, self.staging_name)
        if self.destination_fd is not None:
            os.close(self.destination_fd)
            self.destination_fd = None


class OutgoingTransfer:
    """Files the Mac copies from the guest, sent on a thread of their own, with no more than TRANSFER_WINDOW bytes waiting
    to be acknowledged."""

    def __init__(self, agent, channel, paths):
        self.agent = agent
        self.channel = channel
        self.condition = threading.Condition()
        self.sent = 0
        self.acknowledged = 0
        self.cancelled = False
        self.items = []
        self.total = 0
        for path in paths:
            self._add(os.path.realpath(path), os.path.basename(path.rstrip("/")))

    def _add(self, path, relative):
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode):
            return
        if stat.S_ISDIR(info.st_mode):
            self.items.append((path, 1, 0, info, relative))
            for name in sorted(os.listdir(path)):
                self._add(os.path.join(path, name), f"{relative}/{name}")
        elif stat.S_ISREG(info.st_mode):
            self.items.append((path, 0, info.st_size, info, relative))
            self.total += info.st_size

    def acknowledge(self, count):
        with self.condition:
            self.acknowledged = max(self.acknowledged, count)
            self.condition.notify_all()

    def cancel(self):
        with self.condition:
            self.cancelled = True
            self.condition.notify_all()

    def run(self):
        port, channel = self.agent.port, self.channel
        try:
            port.send(TRANSFER_SIZE, channel, struct.pack("<QI", self.total, len(self.items)))
            for path, item_type, size, info, relative in self.items:
                if self.cancelled:
                    return
                header = FILE_HEADER_FORMAT.pack(item_type, size, stat.S_IMODE(info.st_mode), int(info.st_mtime))
                port.send(FILE_HEADER, channel, header + relative.encode())
                if item_type != 0:
                    continue
                with open(path, "rb") as file:
                    remaining = size
                    while remaining > 0:
                        length = min(remaining, FILE_CHUNK_SIZE)
                        with self.condition:
                            while not self.cancelled and self.sent + length - self.acknowledged > TRANSFER_WINDOW:
                                self.condition.wait()
                            if self.cancelled:
                                return
                        chunk = file.read(length)
                        if not chunk:
                            raise TransferError(f"\u201c{os.path.basename(path)}\u201d got shorter while it was being copied.")
                        port.send(FILE_DATA, channel, chunk)
                        remaining -= len(chunk)
                        with self.condition:
                            self.sent += len(chunk)
            if not self.cancelled:
                port.send(FILES_END, channel)
        except (OSError, TransferError) as error:
            log(f"Channel {channel}: sending files failed: {error}")
            port.send(FAILED, channel, str(error).encode())
        finally:
            self.agent.remove_transfer(self)


class Agent:
    def __init__(self, port):
        self.port = port
        self.sessions = {}
        self.incoming = {}
        self.outgoing = {}
        self.lock = threading.Lock()

    def remove_transfer(self, transfer):
        with self.lock:
            if self.outgoing.get(transfer.channel) is transfer:
                del self.outgoing[transfer.channel]

    def cancel_transfers(self):
        with self.lock:
            incoming, outgoing = list(self.incoming.values()), list(self.outgoing.values())
            self.incoming.clear()
        for transfer in incoming:
            transfer.cleanup()
        for transfer in outgoing:
            transfer.cancel()

    def remove(self, session):
        with self.lock:
            if self.sessions.get(session.channel) is session:
                del self.sessions[session.channel]

    def session(self, channel):
        with self.lock:
            return self.sessions.get(channel)

    def hello(self):
        try:
            with open("/etc/os-release") as file:
                values = dict(line.rstrip("\n").split("=", 1) for line in file if "=" in line)
            name = values.get("PRETTY_NAME", "Linux").strip('"')
        except OSError:
            name = "Linux"
        description = f"{name} ({platform.release()}) {platform.machine()}"
        self.port.send(HELLO, 0, struct.pack("<I", PROTOCOL_VERSION) + description.encode())

    def terminate_all(self):
        with self.lock:
            sessions = list(self.sessions.values())
        for session in sessions:
            session.terminate()

    def handle(self, kind, channel, payload):
        if kind == RESET:
            log("Hypervisaur connected")
            self.terminate_all()
            self.cancel_transfers()
            self.hello()
        elif kind == PUT_FILES:
            self.start_incoming(channel)
        elif kind in (TRANSFER_SIZE, FILE_HEADER, FILE_DATA, FILES_END):
            self.receive_files(kind, channel, payload)
        elif kind == GET_FILES:
            self.start_outgoing(channel, payload)
        elif kind == ACKNOWLEDGE and len(payload) >= 8:
            with self.lock:
                transfer = self.outgoing.get(channel)
            if transfer:
                transfer.acknowledge(struct.unpack_from("<Q", payload)[0])
        elif kind == CATCH_DRAG:
            self.port.send(FAILED, channel, "Dragging files out of Linux isn\u2019t supported.".encode())
        elif kind == OPEN:
            self.open(channel, payload)
        elif kind == INPUT:
            session = self.session(channel)
            if session:
                session.write(payload)
        elif kind == INPUT_END:
            session = self.session(channel)
            if session:
                session.end_input()
        elif kind == RESIZE and len(payload) >= 4:
            session = self.session(channel)
            if session:
                session.resize(*struct.unpack_from("<HH", payload))
        elif kind == TERMINATE:
            with self.lock:
                incoming = self.incoming.pop(channel, None)
                outgoing = self.outgoing.get(channel)
            if incoming:
                incoming.cleanup()
                self.port.send(FAILED, channel, b"Cancelled.")
            elif outgoing:
                outgoing.cancel()
            else:
                session = self.session(channel)
                if session:
                    session.terminate()

    def start_incoming(self, channel):
        try:
            transfer = IncomingTransfer(self, channel)
        except (OSError, TransferError) as error:
            log(f"Channel {channel}: couldn't receive files: {error}")
            self.port.send(FAILED, channel, f"Couldn\u2019t receive the files: {error}".encode())
            return
        with self.lock:
            self.incoming[channel] = transfer

    def receive_files(self, kind, channel, payload):
        with self.lock:
            transfer = self.incoming.get(channel)
        if transfer is None:
            return
        try:
            finished = transfer.receive(kind, payload)
        except (OSError, TransferError) as error:
            log(f"Channel {channel}: receiving files failed: {error}")
            transfer.cleanup()
            finished = True
            self.port.send(FAILED, channel, str(error).encode())
        if finished:
            with self.lock:
                self.incoming.pop(channel, None)

    def start_outgoing(self, channel, payload):
        paths = [line for line in payload.decode("utf-8", "replace").split("\n") if line]
        try:
            transfer = OutgoingTransfer(self, channel, paths)
        except OSError as error:
            log(f"Channel {channel}: couldn't read the files to send: {error}")
            self.port.send(FAILED, channel, f"Couldn\u2019t read the files: {error.strerror or error}.".encode())
            return
        with self.lock:
            self.outgoing[channel] = transfer
        threading.Thread(target=transfer.run, daemon=True).start()

    def open(self, channel, payload):
        if len(payload) < 5:
            self.port.send(FAILED, channel, b"The request to run a program is incomplete.")
            return

        uses_terminal = bool(payload[0] & 1)
        columns, rows = struct.unpack_from("<HH", payload, 1)
        command = payload[5:].decode("utf-8", "replace")

        try:
            session = Session(self, channel, command, uses_terminal, columns or 80, rows or 24)
        except OSError as error:
            log(f"Channel {channel}: couldn't start the program: {error}")
            self.port.send(FAILED, channel, f"Couldn't start the program: {error.strerror or error}.".encode())
            return

        with self.lock:
            self.sessions[channel] = session

    def run(self):
        """Reads frames until the port fails."""
        buffer = bytearray()
        while True:
            data = self.port.read()
            if not data:
                if self.port.ends_when_empty:
                    return
                # Nothing is read while Hypervisaur isn't connected.
                time.sleep(0.25)
                continue

            buffer += data
            while len(buffer) >= HEADER.size:
                length, kind, channel = HEADER.unpack_from(buffer)
                if length > MAX_PAYLOAD:
                    log(f"Received a frame that's too large ({length} bytes), discarding what was received")
                    buffer.clear()
                    break
                if len(buffer) < HEADER.size + length:
                    break
                payload = bytes(buffer[HEADER.size:HEADER.size + length])
                del buffer[:HEADER.size + length]
                self.handle(kind, channel, payload)


def serve_socket():
    """Serves Hypervisaur on the virtio socket, one connection at a time, alongside the console port. Hypervisaur moves to
    the socket when it can connect to it, and back to the console port when the connection ends."""
    while True:
        try:
            listener = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            listener.bind((socket.VMADDR_CID_ANY, SOCKET_PORT))
            listener.listen(1)
        except (OSError, AttributeError) as error:
            log(f"Couldn't listen on virtio socket port {SOCKET_PORT} ({error}), trying again")
            time.sleep(30)
            continue

        log(f"Listening on virtio socket port {SOCKET_PORT}")
        while True:
            try:
                connection, _ = listener.accept()
            except OSError as error:
                log(f"The virtio socket stopped accepting connections ({error})")
                break

            port = SocketPort(connection)
            agent = Agent(port)
            log("Hypervisaur connected over the virtio socket")
            try:
                agent.run()
            except OSError as error:
                log(f"The virtio socket connection ended ({error})")
            agent.terminate_all()
            agent.cancel_transfers()
            port.close()
        listener.close()
        time.sleep(1)


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else PORT_PATH
    threading.Thread(target=serve_socket, daemon=True).start()
    last_error = None

    while True:
        port = Port(path)
        try:
            port.open()
        except OSError as error:
            if str(error) != last_error:
                log(f"Couldn't open {path} ({error}), trying again")
            last_error = str(error)
            time.sleep(5)
            continue

        log(f"Opened {path}")
        last_error = None
        agent = Agent(port)
        agent.hello()
        try:
            agent.run()
        except OSError as error:
            log(f"The port closed ({error}), opening it again")
        agent.terminate_all()
        agent.cancel_transfers()
        with port.lock:
            os.close(port.fd)
            port.fd = None
        time.sleep(1)


if __name__ == "__main__":
    main()
